{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Train: sample (NB + LR)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "args": ["--dataset", "sample", "--models", "nb", "lr"],
      "console": "integratedTerminal"
    },
    {
      "name": "Train: Kaggle (NB + LR)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "args": ["--dataset", "kaggle", "--models", "nb", "lr"],
      "console": "integratedTerminal"
    },
    {
      "name": "Predict: demo text",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/predict.py",
      "args": ["--text", "Scientists discover cure for cancer in just 5 days!"],
      "console": "integratedTerminal"
    },
    {
      "name": "Streamlit app",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "console": "integratedTerminal"
    }
  ]
}
